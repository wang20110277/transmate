# API配置（生产环境）
# SiliconFlow API
API_URL=https://api.siliconflow.cn/v1
API_KEY=sk-your-production-api-key-here

# 数据库配置（生产环境）
DB_HOST=mysql.production.internal
DB_PORT=3306
DB_USER=trans_meta_user
DB_PASSWORD=your-secure-password-here
DB_NAME=trans_meta

# Redis配置（生产环境）
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password-here

# Token安全密钥（生产环境 - 必须修改为强随机字符串）
SECRET_KEY=your-production-secret-key-min-64-chars-long-and-random

# ============================================
# 微信登录配置（生产环境）
# ============================================

# 微信开放平台配置
# 1. 访问 https://open.weixin.qq.com/ 注册开发者账号
# 2. 创建网站应用，获取 AppID 和 AppSecret
# 3. 配置授权回调域名为你的生产域名

WECHAT_APPID=wx-your-production-appid
WECHAT_SECRET=your-production-wechat-secret
WECHAT_REDIRECT_URI=https://your-domain.com/api/auth/wechat/callback

# 微信登录开关
# true - 启用微信登录
# false - 禁用微信登录
WECHAT_LOGIN_ENABLED=true

# ============================================
# 短信服务配置（生产环境）
# ============================================

# 阿里云短信服务
SMS_ACCESS_KEY=your-aliyun-access-key
SMS_SECRET_KEY=your-aliyun-secret-key
SMS_SIGN_NAME=你的短信签名
SMS_TEMPLATE_CODE=SMS_xxxxxx

# ============================================
# 生产环境特定配置
# ============================================

# 应用环境
ENVIRONMENT=production
DEBUG=false

# 日志级别
LOG_LEVEL=INFO

# CORS 配置（生产环境只允许特定域名）
# 多个域名用逗号分隔
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 请求限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# 会话配置
SESSION_TIMEOUT=7200

# 文件上传配置
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/data/uploads

# 监控和告警
SENTRY_DSN=https://your-sentry-dsn
ENABLE_METRICS=true
METRICS_PORT=9090

# SSL/TLS 配置（如果使用 HTTPS）
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem
