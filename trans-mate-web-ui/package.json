{
  "name": "trans-meta-web-ui",
  "version": "1.0.0",
  "description": "虚拟柜员Vue前端",
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 vite",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit",
    "websocket-server": "node server.js",
    "dev-all": "concurrently \"npm run dev\" \"npm run websocket-server\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.13.2",
    "element-plus": "^2.13.2",
    "express": "^5.1.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.47.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.18",
    "vue-router": "^5.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^4.9.0",
    "vite": "^5.4.0",
    "vue-tsc": "^1.0.0"
  }
}
