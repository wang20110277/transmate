{
  "name": "trans-meta-web-ui",
  "productName": "TransMate",
  "version": "1.0.0",
  "description": "TransMate 智能助手",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/wang20110277/transmate.git"
  },
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 vite",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit",
    "websocket-server": "node server.js",
    "dev-all": "concurrently \"npm run dev\" \"npm run websocket-server\"",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "sign:mac": "codesign --force --deep -s - --entitlements build/entitlements.mac.plist \"$(find out -maxdepth 2 -name '*.app' -print -quit)\"",
    "start": "electron-forge start",
    "package": "npm run build:web && electron-forge package && npm run sign:mac",
    "make": "npm run build:web && electron-forge make",
    "publish": "npm run build:web && dotenv -e .env -- electron-forge publish"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "axios": "^1.13.2",
    "electron-squirrel-startup": "^1.0.1",
    "element-plus": "^2.13.2",
    "express": "^5.1.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "pinia": "^3.0.4",
    "update-electron-app": "^3.3.0",
    "vue": "^3.5.18",
    "vue-router": "^5.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/axios": "^0.9.36",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "electron": "^43.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^2.2.12",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {}
}
