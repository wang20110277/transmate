# ============================================
# 基础配置
# ============================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO


# ============================================
# 安全配置
# ============================================

SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7


# ============================================
# 数据库配置
# ============================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=trans_mate
DB_DRIVER=postgresql+psycopg2


# ============================================
# Redis 配置
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=


# ============================================
# LLM API 配置 (SiliconFlow)
# ============================================

DEFAULT_API_URL=https://open.bigmodel.cn/api/paas/v4
DEFAULT_API_KEY=
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=glm-4-flash


# ============================================
# Kimi 模型配置
# ============================================

KIMI_MODEL=kimi-k2-turbo-preview
KIMI_PROVIDER=moonshot
KIMI_API_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_TIMEOUT=60


# ============================================
# 微信登录配置
# ============================================

WECHAT_APPID=
WECHAT_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/auth/wechat/callback
WECHAT_LOGIN_ENABLED=true


# ============================================
# 短信服务配置
# ============================================

SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=


# ============================================
# Tushare 配置
# ============================================

TUSHARE_TOKEN=


# ============================================
# Web Search 配置 (Tavily)
# ============================================

TAVILY_API_KEY=


# ============================================
# CORS 配置
# ============================================

ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true


# ============================================
# 速率限制配置
# ============================================

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60


# ============================================
# 会话配置
# ============================================

SESSION_TIMEOUT=7200


# ============================================
# 文件上传配置
# ============================================

MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/data/uploads


# ============================================
# HuggingFace 模型缓存配置
# ============================================

HF_HOME=/Users/lindaw/Documents/北京传思科技有限公司/trans-mate/trans-mate/app/llm/rag/models
TRANSFORMERS_CACHE=/Users/lindaw/Documents/北京传思科技有限公司/trans-mate/trans-mate/app/llm/rag/models
