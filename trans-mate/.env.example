# ============================================
# 基础配置
# ============================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO


# ============================================
# 安全配置
# ============================================

SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7


# ============================================
# 数据库配置
# ============================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=trans_mate
DB_DRIVER=postgresql+psycopg2


# ============================================
# Redis 配置
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=


# ============================================
# LLM API 配置 (SiliconFlow)
# ============================================

DEFAULT_API_URL=https://open.bigmodel.cn/api/paas/v4
DEFAULT_API_KEY=
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=glm-4-flash


# ============================================
# Kimi 模型配置
# ============================================

KIMI_MODEL=kimi-k2-turbo-preview
KIMI_PROVIDER=moonshot
KIMI_API_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_TIMEOUT=60


# ============================================
# 微信登录配置
# ============================================

WECHAT_APPID=
WECHAT_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/auth/wechat/callback
WECHAT_LOGIN_ENABLED=true


# ============================================
# 短信服务配置
# ============================================

SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=


# ============================================
# Tushare 配置
# ============================================

TUSHARE_TOKEN=


# ============================================
# Web Search 配置 (Tavily)
# ============================================

TAVILY_API_KEY=


# ============================================
# CORS 配置
# ============================================

ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true


# ============================================
# 速率限制配置
# ============================================

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60


# ============================================
# 会话配置
# ============================================

SESSION_TIMEOUT=7200


# ============================================
# 文件上传配置
# ============================================

MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/data/uploads


# ============================================
# HuggingFace 模型缓存配置
# ============================================

HF_HOME=/Users/lindaw/Documents/北京传思科技有限公司/trans-mate/trans-mate/app/llm/rag/models
TRANSFORMERS_CACHE=/Users/lindaw/Documents/北京传思科技有限公司/trans-mate/trans-mate/app/llm/rag/models


# ============================================
# Skill 注册表 (GitHub 仓库)
# ============================================

SKILL_REGISTRY_OWNER=anthropics
SKILL_REGISTRY_REPO=skills
SKILL_REGISTRY_REF=main
SKILL_REGISTRY_SUBDIR=
SKILL_REGISTRY_TOKEN=
SKILL_REGISTRY_PROXY=
SKILL_REGISTRY_CACHE_TTL=300


# ============================================
# MinIO 对象存储
# (注意:MINIO_ENDPOINT 必须是前端/Electron 客户端可达的地址——
#  制品下载用预签名 URL,由浏览器直连 MinIO,签名绑定该主机名,部署时需对外开放端口)
# ============================================

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=transmate
MINIO_SECURE=false


# ============================================
# 用户云工作区 (服务器本地目录)
# ============================================

SANDBOX_ROOT=
SKILL_CACHE_ROOT=


# ============================================
# 防护上限
# ============================================

SKILL_MAX_FILE_BYTES=10485760
SKILL_MAX_FILES=200
ARTIFACT_MAX_BYTES=209715200
ARTIFACT_MAX_COUNT=500
